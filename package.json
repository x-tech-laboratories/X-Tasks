{
  "name": "x-tasks",
  "version": "0.1.0",
  "description": "A todo manager",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/with_dev_database.sh electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "app": "bash scripts/with_dev_database.sh bash scripts/run.sh",
    "seed": "vite build -c vite.seed.config.ts && node out/seed/index.js dev-data/tasks.db --reset",
    "build:server": "npm run typecheck && vite build -c vite.web.config.ts && vite build -c vite.server.config.ts",
    "server": "node out/server/index.js",
    "build:android": "npm run typecheck && vite build -c vite.android.config.ts && cap sync android",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "frappe-gantt": "1.2.2",
    "fullcalendar": "7.1.3",
    "preact": "^10.29.8",
    "recurrence-input": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.5",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
