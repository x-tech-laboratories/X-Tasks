{
  "name": "x-tasks",
  "version": "0.1.0",
  "description": "A todo manager",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "app": "bash scripts/run.sh",
    "build:server": "npm run typecheck && vite build -c vite.web.config.ts && vite build -c vite.server.config.ts",
    "server": "node out/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "preact": "^10.29.8",
    "recurrence-input": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.5",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
