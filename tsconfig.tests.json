{
  "extends": "./tsconfig.base.json",
  "include": ["tests/**/*", "vitest.config.ts", "src/preload/index.d.ts", "src/web/**/*.d.ts"],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@web/*": ["./src/web/*"], "@shared/*": ["./src/shared/*"] }
  }
}
