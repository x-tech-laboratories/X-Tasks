{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "src/renderer/**/*", "src/preload/*.d.ts", "src/shared/**/*",
    "src/main/sql_database.ts", "src/main/task_database.ts", "src/main/sync_engine.ts", "src/main/sync_client.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/*"], "@shared/*": ["src/shared/*"] }
  }
}
